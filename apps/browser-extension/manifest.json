{
  "manifest_version": 3,
  "name": "Workspace Web",
  "version": "0.1.0",
  "description": "Send the page you are working on to Workspace.",
  "key": "",
  "action": {
    "default_title": "Send page to Workspace",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "tabs",
    "storage"
  ],
  "commands": {
    "send-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "Send current page to Workspace"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
